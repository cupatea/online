<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Caddy admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header>
      <div>
        <%= link_to "Caddy admin", root_path, class: "brand" %>
        <nav>
          <%= link_to "Services", root_path %>
          <%= link_to "Settings", setting_path %>
        </nav>
      </div>
    </header>

    <main>
      <% if notice %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>

      <%= yield %>
    </main>
  </body>
</html>
