<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Caddy admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <% if dashboard_mode? %>
      <link rel="preconnect" href="https://services.bonjourr.fr" crossorigin>
      <link rel="preconnect" href="https://images.unsplash.com">
    <% end %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body class="<%= [dashboard_mode? ? "dashboard" : nil, content_for(:body_class)].compact.join(" ") %>">
    <% unless dashboard_mode? %>
      <header>
        <div>
          <%= link_to "Caddy admin", root_path, class: "brand" %>
          <% if admin_authenticated? %>
            <nav>
              <%= link_to "Services", root_path, class: "nav-item" %>
              <%= link_to "Settings", setting_path, class: "nav-item" %>
              <%= button_to "Sign out", admin_logout_path, method: :delete, class: "nav-item" %>
            </nav>
          <% end %>
        </div>
      </header>
    <% end %>

    <main>
      <% if notice %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>

      <%= yield %>
    </main>
  </body>
</html>
