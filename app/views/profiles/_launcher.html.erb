<% links = profile.links.enabled.includes(:category).ordered.to_a %>
<% if links.empty? %>
  <div class="empty">
    <p>No links yet.</p>
    <p><%= link_to "Add some →", profile_links_path(profile) %></p>
  </div>
<% else %>
  <% sections = profile.categories.ordered.filter_map { |c|
       ls = links.select { |l| l.category_id == c.id }
       [ c.name, ls ] if ls.any?
     } %>
  <% uncategorized = links.select { |l| l.category_id.nil? } %>
  <% sections << [ "Other", uncategorized ] if uncategorized.any? %>

  <% if sections.size <= 1 %>
    <%# No categories, or just one — flat grid, no headings. %>
    <%= render "profiles/tiles", links: links %>
  <% else %>
    <% sections.each do |label, ls| %>
      <section class="dash-section">
        <h2 class="dash-section-title"><%= label %></h2>
        <%= render "profiles/tiles", links: ls %>
      </section>
    <% end %>
  <% end %>
<% end %>
