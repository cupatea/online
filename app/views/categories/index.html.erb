<% content_for :title, "Categories · #{@profile.name}" %>

<%= render layout: "shared/modal" do %>
  <%= render "shared/manage_header", section: :categories, add_path: new_profile_category_path(@profile) %>

  <% if @categories.any? %>
    <ul class="link-list cat-reorder" data-reorder-url="<%= reorder_profile_categories_path(@profile) %>">
      <% @categories.each do |category| %>
        <li class="link-item" data-id="<%= category.id %>" draggable="true">
          <span class="link-item-main">
            <span class="link-grip" aria-hidden="true">⠿</span>
            <span class="link-item-title"><%= category.name %></span>
            <span class="link-flag"><%= pluralize(category.links.count, "link") %></span>
          </span>
          <span class="link-item-actions">
            <%= link_to "Edit", edit_profile_category_path(@profile, category), class: "button link" %>
            <%= button_to "Delete", profile_category_path(@profile, category), method: :delete,
                          onclick: "return confirm('Delete category #{j category.name}? Its links stay, just uncategorized.')",
                          class: "button danger" %>
          </span>
        </li>
      <% end %>
    </ul>
    <p class="help">Drag to reorder.</p>
  <% else %>
    <p class="help">No categories yet. Add one, then assign links to it when editing a link.</p>
  <% end %>
<% end %>

<script>
  // Drag-to-reorder categories.
  (function () {
    var list = document.querySelector(".cat-reorder[data-reorder-url]");
    if (!list) return;
    var url = list.dataset.reorderUrl, dragging = null;

    list.querySelectorAll(".link-item").forEach(function (li) {
      li.addEventListener("dragstart", function (e) {
        dragging = li; li.classList.add("dragging"); e.dataTransfer.effectAllowed = "move";
        try { e.dataTransfer.setData("text/plain", li.dataset.id); } catch (x) {}
      });
      li.addEventListener("dragend", function () { li.classList.remove("dragging"); dragging = null; persist(); });
    });

    list.addEventListener("dragover", function (e) {
      if (!dragging) return;
      e.preventDefault();
      var after = closest(e.clientY);
      if (after == null) list.appendChild(dragging); else list.insertBefore(dragging, after);
    });

    function closest(y) {
      var els = [].slice.call(list.querySelectorAll(".link-item:not(.dragging)"));
      var best = null, bo = -Infinity;
      els.forEach(function (el) {
        var b = el.getBoundingClientRect(), o = y - b.top - b.height / 2;
        if (o < 0 && o > bo) { bo = o; best = el; }
      });
      return best;
    }

    function persist() {
      var ids = [].slice.call(list.querySelectorAll(".link-item")).map(function (li) { return li.dataset.id; });
      var t = document.querySelector('meta[name="csrf-token"]');
      fetch(url, { method: "POST", headers: { "Content-Type": "application/json", "X-CSRF-Token": t ? t.content : "" }, body: JSON.stringify({ ids: ids }) });
    }
  })();
</script>
