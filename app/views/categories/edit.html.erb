<% content_for :title, "Edit category · #{@profile.name}" %>

<%= render layout: "shared/modal" do %>
  <%= render "shared/manage_header", title: "Edit category" %>
  <%= form_with model: @category, url: profile_category_path(@profile, @category), method: :patch, class: "stack" do |f| %>
    <% if @category.errors.any? %>
      <div class="errors">
        <ul><% @category.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
      </div>
    <% end %>
    <div>
      <%= f.label :name %>
      <%= f.text_field :name, autofocus: true %>
    </div>
    <div class="actions">
      <%= f.submit "Save" %>
      <%= link_to "Cancel", profile_categories_path(@profile), class: "button link" %>
    </div>
  <% end %>
<% end %>
