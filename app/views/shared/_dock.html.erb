<%# Bottom-right dock — identical shape on every launcher page so nothing shifts.
    Top level: "manage links" (active on a profile, disabled on the NAS dashboard).
    Main row: NAS dashboard button + a circle per profile, always in the same order.
    `current` is :dashboard or the current Profile; it only changes highlights. %>
<nav class="dock" aria-label="Navigation">
  <div class="dock-row dock-row-top">
    <% if current.is_a?(Profile) %>
      <%= link_to profile_links_path(current), class: "dock-item dock-edit", title: "Manage links" do %>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
      <% end %>
    <% else %>
      <span class="dock-item dock-edit is-disabled" title="Open a profile to manage its links" aria-disabled="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
        </svg>
      </span>
    <% end %>
  </div>

  <div class="dock-row dock-row-main">
    <%= link_to root_path, class: "dock-item dock-home #{'current' if current == :dashboard}", title: "NAS dashboard" do %>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="6" rx="1"></rect>
        <rect x="3" y="14" width="18" height="6" rx="1"></rect>
      </svg>
    <% end %>
    <% dock_profiles.each do |profile| %>
      <%= link_to profile.name.to_s.first.to_s.upcase, profile_path(profile),
                  class: "dock-item #{'current' if current.is_a?(Profile) && current.id == profile.id}",
                  title: profile.name %>
    <% end %>
  </div>
</nav>
