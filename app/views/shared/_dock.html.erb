<%# Bottom-right dock. On the NAS dashboard it lists the profiles; on a profile
    it shows only the link back to the NAS dashboard. %>
<% if current == :dashboard %>
  <% if dock_profiles.any? %>
    <nav class="dock" aria-label="Profiles">
      <% dock_profiles.each do |profile| %>
        <%= link_to profile.name.to_s.first.to_s.upcase, profile_path(profile),
                    class: "dock-item", title: profile.name %>
      <% end %>
    </nav>
  <% end %>
<% elsif current.is_a?(Profile) %>
  <nav class="dock" aria-label="Navigation">
    <%= link_to root_path, class: "dock-item dock-home", title: "NAS dashboard" do %>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="6" rx="1"></rect>
        <rect x="3" y="14" width="18" height="6" rx="1"></rect>
      </svg>
    <% end %>
    <%= link_to profile_links_path(current), class: "dock-item dock-edit", title: "Manage links" do %>
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9"></path>
        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
      </svg>
    <% end %>
  </nav>
<% end %>
