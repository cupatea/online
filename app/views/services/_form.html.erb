<%= form_with model: service, class: "stack" do |f| %>
  <% if service.errors.any? %>
    <div class="errors">
      <p><%= pluralize(service.errors.count, "error") %> prevented saving:</p>
      <ul>
        <% service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "Caramba" %>
    <p class="help">Display name only. Anything memorable.</p>
  </div>

  <div>
    <%= f.label :hostname %>
    <%= f.text_field :hostname, placeholder: "caramba.example.com", class: "mono" %>
    <p class="help">Public hostname. A CNAME for this name must already point to the host running Caddy.</p>
  </div>

  <div class="row">
    <div>
      <%= f.label :upstream_host, "Upstream host" %>
      <%= f.text_field :upstream_host, class: "mono" %>
    </div>
    <div>
      <%= f.label :upstream_port, "Port" %>
      <%= f.number_field :upstream_port, min: 1, max: 65535, class: "mono" %>
    </div>
  </div>
  <p class="help">Docker Desktop (macOS/Windows): use <span class="mono">host.docker.internal</span> to reach services on the host. Linux with <span class="mono">network_mode: host</span>: <span class="mono">localhost</span>.</p>

  <div class="checkbox">
    <%= f.check_box :enabled %>
    <%= f.label :enabled, "Enabled" %>
    <span>— uncheck to keep the row but stop serving the site.</span>
  </div>

  <div class="actions">
    <%= f.submit %>
    <%= link_to "Cancel", root_path, class: "button link" %>
  </div>
<% end %>
