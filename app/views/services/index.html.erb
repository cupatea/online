<% content_for :title, "Services" %>

<% unless @setting.complete? %>
  <div class="warn">
    <p><strong>Finish setup first.</strong></p>
    <p>Caddy can't issue certificates until you provide a Cloudflare API token and an ACME email.</p>
    <p><%= link_to "Open settings →", setting_path %></p>
  </div>
<% end %>

<div class="toolbar">
  <h1>Services</h1>
  <div class="actions">
    <%= button_to "Republish", republish_path, method: :post, class: "button secondary" %>
    <%= link_to "+ Add service", new_service_path, class: "button" %>
  </div>
</div>

<% if @services.any? %>
  <table>
    <thead>
      <tr>
        <th>Upstream</th>
        <th>Hostname</th>
        <th>Enabled</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @services.each do |service| %>
        <tr>
          <td>
            <div class="name"><%= service.name %></div>
            <div class="sub"><%=  service.upstream %></div>
          </td>
          <td class="mono"><%= service.hostname %></td>
          <td>
            <% if service.enabled? %>
              <span class="tag on">on</span>
            <% else %>
              <span class="tag off">off</span>
            <% end %>
          </td>
          <td class="right">
            <%= link_to "Edit", edit_service_path(service), class: "button link" %>
            <%= button_to "Delete", service_path(service), method: :delete,
                          onclick: "return confirm('Delete #{service.hostname}?')",
                          class: "button danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty">
    <p>No services yet.</p>
    <p><%= link_to "Add your first service →", new_service_path %></p>
  </div>
<% end %>
