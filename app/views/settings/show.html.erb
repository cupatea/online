<% content_for :title, "Settings" %>

<h1>Settings</h1>

<%= form_with model: @setting, url: setting_path, method: :patch, class: "stack" do |f| %>
  <% if @setting.errors.any? %>
    <div class="errors">
      <ul>
        <% @setting.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :acme_email, "Let's Encrypt email" %>
    <%= f.email_field :acme_email %>
    <p class="help">Used for the ACME account &amp; cert-expiry warnings. Real inbox.</p>
  </div>

  <div>
    <%= f.label :cloudflare_token, "Cloudflare API token" %>
    <%= f.text_field :cloudflare_token, class: "mono" %>
    <p class="help">
      Permissions: <span class="mono">Zone → DNS → Edit</span>, scoped to your zone.
      Create one at <a href="https://dash.cloudflare.com/profile/api-tokens" target="_blank" rel="noopener">dash.cloudflare.com</a>.
    </p>
  </div>

  <fieldset class="presets">
    <legend>Form defaults</legend>
    <p class="help">Suggestions for the Add/Edit service form. One per line; the top line is preselected. Values from your existing services are also suggested automatically.</p>

    <div>
      <%= f.label :base_domains, "Base domains" %>
      <%= f.text_area :base_domains, rows: 3, class: "mono"%>
      <p class="help">You type just the subdomain (e.g. <span class="mono">caramba</span>) and this gets appended.</p>
    </div>

    <div>
      <%= f.label :upstream_hosts, "Upstream hosts" %>
      <%= f.text_area :upstream_hosts, rows: 3, class: "mono" %>
      <p class="help">The host/IP your services run on.</p>
    </div>
  </fieldset>

  <div>
    <%= f.submit "Save settings" %>
  </div>
<% end %>

<div class="note">
  <p>Settings are stored in the admin app's SQLite database. The token is sent to Caddy's admin API in plain text on save (and on each app boot).</p>
</div>
