<% content_for :title, "Links · #{@profile.name}" %>

<%= render layout: "shared/modal" do %>
  <%= render "shared/manage_header", section: :links, add_path: new_profile_link_path(@profile) %>

  <% if @enabled_links.any? %>
    <div class="cat-groups" data-reorder-url="<%= reorder_profile_links_path(@profile) %>">
      <% @categories.each do |cat| %>
        <% ls = @enabled_links.select { |l| l.category_id == cat.id } %>
        <% next if ls.empty? %>
        <div class="cat-group">
          <h2 class="panel-sub"><%= cat.name %></h2>
          <ul class="cat-links">
            <%= render partial: "links/row", collection: ls, as: :link %>
          </ul>
        </div>
      <% end %>

      <% uncategorized = @enabled_links.select { |l| l.category_id.nil? } %>
      <% if uncategorized.any? %>
        <div class="cat-group">
          <% if @categories.any? %><h2 class="panel-sub">Other</h2><% end %>
          <ul class="cat-links">
            <%= render partial: "links/row", collection: uncategorized, as: :link %>
          </ul>
        </div>
      <% end %>
    </div>
    <p class="help">Drag a link to reorder it within its category.</p>
  <% end %>

  <% if @disabled_links.any? %>
    <h2 class="panel-sub">Disabled</h2>
    <ul class="link-list">
      <%= render partial: "links/row", collection: @disabled_links, as: :link %>
    </ul>
  <% end %>

  <% if @enabled_links.empty? && @disabled_links.empty? %>
    <p class="help">No links yet. Add your first one above.</p>
  <% end %>
<% end %>

<script>
  // Links reorder within their own category (native HTML5 DnD). Categories are
  // ordered in the Categories section, not here. Persists the full flattened
  // order so each category's links stay contiguous.
  (function () {
    var container = document.querySelector(".cat-groups[data-reorder-url]");
    if (!container) return;
    var url = container.dataset.reorderUrl, dragging = null;

    container.querySelectorAll(".link-item").forEach(function (li) {
      li.addEventListener("dragstart", function (e) {
        dragging = li; li.classList.add("dragging"); e.dataTransfer.effectAllowed = "move";
        try { e.dataTransfer.setData("text/plain", li.dataset.id); } catch (x) {}
      });
      li.addEventListener("dragend", function () { li.classList.remove("dragging"); dragging = null; persist(); });
    });

    container.addEventListener("dragover", function (e) {
      if (!dragging) return;
      e.preventDefault();
      var ul = dragging.parentNode; // keep the link inside its own category
      var after = closest(ul, e.clientY);
      if (after == null) ul.appendChild(dragging); else ul.insertBefore(dragging, after);
    });

    function closest(ul, y) {
      var els = [].slice.call(ul.querySelectorAll(".link-item:not(.dragging)"));
      var best = null, bo = -Infinity;
      els.forEach(function (el) {
        var b = el.getBoundingClientRect(), o = y - b.top - b.height / 2;
        if (o < 0 && o > bo) { bo = o; best = el; }
      });
      return best;
    }

    function persist() {
      var ids = [];
      container.querySelectorAll(".cat-links .link-item").forEach(function (li) { ids.push(li.dataset.id); });
      var t = document.querySelector('meta[name="csrf-token"]');
      fetch(url, { method: "POST", headers: { "Content-Type": "application/json", "X-CSRF-Token": t ? t.content : "" }, body: JSON.stringify({ ids: ids }) });
    }
  })();
</script>
