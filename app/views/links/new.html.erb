<% content_for :title, "Add link · #{@profile.name}" %>

<%= render layout: "shared/modal" do %>
  <%= render "shared/manage_header", title: "Add link" %>
  <%= render "links/form", profile: @profile, link: @link,
             url: profile_links_path(@profile), method: :post, submit: "Add link" %>
<% end %>
