<% content_for :title, "Edit #{@link.title} · #{@profile.name}" %>

<%= render layout: "shared/modal" do %>
  <%= render "shared/manage_header", title: "Edit link" %>
  <%= render "links/form", profile: @profile, link: @link,
             url: profile_link_path(@profile, @link), method: :patch, submit: "Save" %>
<% end %>
