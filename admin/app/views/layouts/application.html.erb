<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Caddy admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
    <header class="border-b border-stone-200 bg-white">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
        <%= link_to "Caddy admin", root_path, class: "font-semibold tracking-tight" %>
        <nav class="flex gap-4 text-sm text-stone-600">
          <%= link_to "Services", root_path, class: "hover:text-stone-900" %>
          <%= link_to "Settings", setting_path, class: "hover:text-stone-900" %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-8">
      <% if notice %>
        <div class="mb-4 rounded border border-green-300 bg-green-50 px-4 py-2 text-sm text-green-900"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 rounded border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-900"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
